# AegisBid Environment Configuration Template
# Browser-visible parameters (Vite)
VITE_MIDNIGHT_NETWORK=preprod
VITE_PROOF_SERVER_URL=http://127.0.0.1:6300
VITE_AEGISBID_CONTRACT_ADDRESS=
VITE_BACKEND_API_URL=http://127.0.0.1:8000

# Server-Side Backend Parameters (FastAPI)
ENVIRONMENT=development
# Neon Postgres: pooled connection for normal API traffic
DATABASE_URL=sqlite+aiosqlite:///./aegisbid.db
# Neon Postgres: direct connection string for schema migrations
DIRECT_DATABASE_URL=sqlite:///./aegisbid.db

# Official Google GenAI SDK (Server-Side Only)
# Never place Gemini API keys or private wallet secrets in browser-visible variables
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
